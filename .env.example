# Copy this file to .env. Create a Google OAuth "Web application" client and
# add http://127.0.0.1:8787/auth/google/callback as its authorised redirect URI.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# Public HTTPS address of this deployment. It must match the Google OAuth
# authorised redirect URI: https://your-domain.example/auth/google/callback
JAMAL_PUBLIC_URL=https://your-domain.example

# Optional: leave unset to generate and retain a local session secret automatically.
JAMAL_SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional: how many videos render at the same time (default 5). The others wait
# in the queue. Set 1 to render strictly one after another.
# JAMAL_PARALLEL_RENDERS=1
