# Copy to /opt/jamal/.env and fill in. Used by Docker Compose and by the app itself.

# Public host name Caddy serves and gets the certificate for. Without a domain,
# <ip-with-dashes>.sslip.io works, e.g. 46-101-103-174.sslip.io.
JAMAL_DOMAIN=your-domain.example
JAMAL_PUBLIC_URL=https://your-domain.example
# Optional: requests to http://<this IP> are redirected to the domain.
JAMAL_SERVER_IP=

# Largest single upload request (a quick-render batch or one project video).
JAMAL_UPLOAD_LIMIT=2GB
# Memory cap for the app container; leave room for the OS, Docker and Caddy.
JAMAL_MEM_LIMIT=6500m

# Videos rendered at the same time; the rest wait in the queue (app default 5).
# Each render already uses every CPU core, so on a small server 1 finishes the
# queue about as fast and keeps memory low.
JAMAL_PARALLEL_RENDERS=1

# Optional: time zone for the date in project video file names (UTC when unset).
# TZ=Europe/Moscow

# Optional Google sign-in and Google Drive (see the main README). Redirect URI:
#   ${JAMAL_PUBLIC_URL}/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional: when unset, a session secret is generated and kept in the data volume.
# It also encrypts stored Google Drive tokens, so do not change it casually.
# JAMAL_SESSION_SECRET=
